   "id": "b6e7c4bb-84b8-4bee-a7b8-d72b44877b78",
   "metadata": {},
   "outputs": [],
   "source": [
    "orders = [\n",
    "    {\"customer\":\"Ahmet\", \"items\": [\"Laptop\",\"Mouse\",\"Mouse\"], \"total\":18500, \"is_paid\":True},\n",
    "    {\"customer\":\"Zeynep\", \"items\": [\"Keyboard\"], \"total\":2500, \"is_paid\":False},\n",
    "    {\"customer\":\"Mehmet\", \"items\": [\"Monitor\",\"HDMI Cable\",\"Monitor\"], \"total\":7200, \"is_paid\":True},\n",
    "    {\"customer\":\"Mehmet\", \"items\": [\"Monitor\",\"HDMI Cable\",\"Monitor\"], \"total\":7200, \"is_paid\":True}\n",
    "]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "07af7d18-fc33-448c-9a9d-44fd46c7cae2",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Total Orders: 4\n",
      "Paid: 3, Unpaid: 1\n"
     ]
    }
   ],
   "source": [
    "total_orders = len(orders)\n",
    "paid_count = 0\n",
    "unpaid_count = 0\n",
    "\n",
    "\n",
    "if orders[0][\"is_paid\"]: \n",
    "    paid_count += 1\n",
    "else: \n",
    "    unpaid_count += 1\n",
    "\n",
    "if orders[1][\"is_paid\"]: \n",
    "    paid_count += 1\n",
    "else: \n",
    "    unpaid_count += 1\n",
    "\n",
    "if orders[2][\"is_paid\"]: \n",
    "    paid_count += 1\n",
    "else: \n",
    "    unpaid_count += 1\n",
    "\n",
    "if orders[3][\"is_paid\"]: \n",
    "    paid_count += 1\n",
    "else: \n",
    "    unpaid_count += 1\n",
    "\n",
    "print(f\"Total Orders: {total_orders}\")\n",
    "print(f\"Paid: {paid_count}, Unpaid: {unpaid_count}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "bf7712f2-e321-40cd-b45a-335df9259418",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Unique Customers: ['Ahmet', 'Mehmet', 'Zeynep']\n",
      "Number of Unique Customers: 3\n"
     ]
    }
   ],
   "source": [
    "\n",
    "customer_names = [\n",
    "    orders[0][\"customer\"], \n",
    "    orders[1][\"customer\"], \n",
    "    orders[2][\"customer\"], \n",
    "    orders[3][\"customer\"]\n",
    "]\n",
    "\n",
    "\n",
    "unique_customers = list(set(customer_names))\n",
    "\n",
    "print(f\"Unique Customers: {unique_customers}\")\n",
    "print(f\"Number of Unique Customers: {len(unique_customers)}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "b018e12c-eddb-4e89-beb0-f7defcfbbf74",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Mehmet's unique items: {'Monitor', 'HDMI Cable'}\n",
      "Total unique items: 2\n"
     ]
    }
   ],
   "source": [
    "\n",
    "mehmet_items = orders[2][\"items\"]\n",
    "\n",
    "\n",
    "unique_items = set(mehmet_items)\n",
    "\n",
    "print(f\"Mehmet's unique items: {unique_items}\")\n",
    "print(f\"Total unique items: {len(unique_items)}\")"
   ]
  },
